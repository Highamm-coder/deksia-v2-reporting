# Copy to web/.env.local and fill in. (.env.local is git-ignored.)
NEXT_PUBLIC_SUPABASE_URL=https://ykxauddrsnuwkvimkdhw.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---- PROTOTYPE: /admin/live (live vs stored) ----------------------------------------------
# Only needed for the live-fetch prototype page. Same names and values as the GitHub Actions
# secrets the nightly run uses. Server-side only: none of these may start with NEXT_PUBLIC_.
# Set by Matt, here for local dev and in Vercel (Project → Settings → Environment Variables,
# Production + Preview) for the deployed console. A source whose variables are missing shows
# "not configured" on the page; the rest still work.
#
# Google Ads, GA4 and Search Console (one OAuth user for all three):
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
# Google Ads only:
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# CallRail:
CALLRAIL_API_KEY=
# Meta (only for clients with a Meta mapping):
META_ACCESS_TOKEN=
