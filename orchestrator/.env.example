# Orchestrator secrets — copy to orchestrator/.env (git-ignored) and fill in.
# Run locally with:  node --env-file=orchestrator/.env orchestrator/run.mjs
# In CI, set these as GitHub Actions repository secrets instead (never committed).
# Full setup walkthrough: orchestrator/HEADLESS-SETUP.md

SUPABASE_URL=https://ykxauddrsnuwkvimkdhw.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
INGEST_TOKEN=

# Google OAuth as the user that already has access to all GA4 properties + the Ledger
# sheet (no per-account grants). Powers GA4 (Analytics Data API) + Sheets API.
# Create a "Desktop app" OAuth client, then mint the refresh token once:
#   GOOGLE_OAUTH_CLIENT_ID=... GOOGLE_OAUTH_CLIENT_SECRET=... node orchestrator/get-refresh-token.mjs
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# Meta Graph API — long-lived system-user token (ads_read; add
# pages_read_engagement + read_insights to also pull Facebook Pages).
META_ACCESS_TOKEN=

# CallRail v3 REST (calls/forms)
CALLRAIL_API_KEY=

# Optional window override (default = yesterday, America/New_York)
# RUN_DATE=2026-07-06
