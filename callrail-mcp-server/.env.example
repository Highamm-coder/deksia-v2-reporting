# CallRail MCP server configuration
# Copy to .env and fill in your values, or set these in your MCP client config.

# Required: your CallRail API key (Account settings -> API Keys in the CallRail app).
CALLRAIL_API_KEY=your_api_key_here

# Optional: a default account ID so tools can omit the account_id argument.
# Find it with the callrail_list_accounts tool, or in the CallRail app URL.
# Accepts the long token form (ACC...) or the 9-digit numeric ID.
CALLRAIL_ACCOUNT_ID=

# Optional: transport mode. 'stdio' (default) for local clients like Claude
# Desktop, or 'http' to run a streamable HTTP server.
TRANSPORT=stdio

# Optional: port for the HTTP transport (only used when TRANSPORT=http).
PORT=3000
