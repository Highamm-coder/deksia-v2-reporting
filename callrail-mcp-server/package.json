{
  "name": "callrail-mcp-server",
  "version": "1.0.0",
  "description": "MCP server for the CallRail v3 API. Exposes call tracking, attribution, call/form summaries, conversations, trackers, companies, leads, and more as LLM tools.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "callrail-mcp-server": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "clean": "rm -rf dist",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "axios": "^1.7.9",
    "dotenv": "^17.4.2",
    "express": "^4.21.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
